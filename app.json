{
  "expo": {
    "name": "Livros e Lombadas",
    "slug": "livros-e-lombadas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.letrometro.livroselombadas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Livros e Lombadas precisa da câmara para identificar livros através da lombada ou capa."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "d7eba52e-a421-42cf-bdf5-638e9b22bbbf"
      }
    }
  }
}
